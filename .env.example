DEBUG=

# GeoID credentials used to authenticate against the NiB token endpoint.
NIB_USERNAME=
NIB_PASSWORD=

# NiB token endpoint and default token validity (seconds).
NIB_TOKEN_URL=https://backend-api.klienter-prod-k8s2.norgeibilder.no/token/tilecache
TOKEN_VALIDITY_SECONDS=3600

# Path to the service registry config (see services.yaml).
SERVICES_CONFIG_PATH=services.yaml

# Max number of entries kept in the in-memory response cache.
CACHE_MAX_ENTRIES=5000

# CORS settings, comma-separated. Defaults allow any origin/method/header,
# which is generally safe here since requests aren't cookie-authenticated
# (the NiB token is looked up server-side, not sent by the browser).
# Set CORS_ALLOW_ORIGINS to a comma-separated allowlist to restrict it.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=False

# Mount all routes (including /healthz) under this base path, e.g. "/nib",
# so the proxy can be exposed at https://host/nib/... without the reverse
# proxy needing to strip the prefix. Leave empty to serve at the root.
BASE_PATH=

# Public URL this proxy is reachable at, e.g. "https://example.org".
# When set, upstream base URLs found in textual response bodies (e.g. WMS/
# WMTS Capabilities documents) are rewritten to point back at this proxy
# (scheme/port/host of the upstream is matched regardless of what's
# configured in services.yaml), so clients keep going through the proxy
# for subsequent requests instead of bypassing it. Leave empty to disable
# rewriting.
PUBLIC_BASE_URL=

